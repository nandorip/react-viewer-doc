{
  "name": "react-viewer-doc",
  "version": "0.4.1",
  "description": "React document viewer for PDF, TIFF and images with pan, zoom, rotate and i18n.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "jest --runInBand",
    "dev": "node scripts/demo.mjs",
    "start": "node scripts/demo.mjs",
    "build:lib": "node scripts/clean-dist.cjs && tsc --project tsconfig.json",
    "prepublishOnly": "npm test && npm run build:lib",
    "build": "node scripts/demo.mjs --production",
    "deploy": "gh-pages -d example/dist",
    "publish-demo": "npm run build && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandorip/react-document-viewer.git"
  },
  "keywords": [
    "react",
    "react-component",
    "document-viewer",
    "pdf-viewer",
    "image-viewer",
    "react-pdf",
    "file-viewer",
    "viewer",
    "pdf",
    "image",
    "tiff",
    "typescript"
  ],
  "author": "Fernando Pires Reherman <nandorip@live.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nandorip/react-document-viewer/issues"
  },
  "homepage": "https://github.com/nandorip/react-document-viewer#readme",
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": ">=6 <10",
    "@mui/material": ">=6 <10",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "react-pdf": "^10.4.1",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ts-jest": "^29.4.9",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
