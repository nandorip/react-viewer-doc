{
  "name": "react-document-viewer",
  "version": "0.1.0",
  "description": "React document viewer for PDF and images with pan, zoom, rotate and full i18n support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.cjs",
    "dev": "webpack serve --mode development",
    "prestart": "node scripts/copy-pdf-worker.cjs",
    "start": "webpack serve --mode development",
    "start:dist": "npm run build:lib && webpack serve --mode development --env dist",
    "build": "webpack --mode production",
    "clean": "node scripts/clean-dist.cjs",
    "transpile": "babel src -d dist --extensions \".ts,.tsx\" --ignore \"src/**/*.test.ts\",\"src/**/*.test.tsx\",\"src/**/*.test.js\"",
    "build:types": "tsc --project tsconfig.json",
    "build:lib": "npm run clean && npm run transpile && npm run build:types",
    "test": "jest",
    "pack:check": "npm pack --dry-run",
    "pack:local": "npm pack",
    "link:local": "npm run build:lib && npm link",
    "publish:prepare": "npm test -- --runInBand && npm run build:lib && npm pack --dry-run",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm test -- --runInBand && npm run build:lib"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandorip/react-document-viewer.git"
  },
  "keywords": [
    "react",
    "react-component",
    "document-viewer",
    "pdf-viewer",
    "image-viewer",
    "react-pdf",
    "file-viewer",
    "viewer",
    "pdf",
    "image",
    "typescript",
    "mui",
    "emotion",
    "zoom",
    "pan",
    "rotate",
    "i18n"
  ],
  "author": "Fernando Pires Reherman <nandorip@live.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nandorip/react-document-viewer/issues"
  },
  "homepage": "https://github.com/nandorip/react-document-viewer#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": ">=6 <10",
    "@mui/material": ">=6 <10",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "react-image-pan-zoom-rotate": "^1.6.0",
    "react-pdf": "^10.4.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.7.3",
    "webpack": "^5.106.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
