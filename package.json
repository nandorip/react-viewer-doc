{
  "name": "react-document-viewer",
  "version": "0.1.0",
  "description": "A React component for document viewing (image and PDF).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "transpile": "babel src -d dist --extensions \".ts,.tsx\" --copy-files",
    "build:types": "tsc --project tsconfig.json",
    "build:lib": "npm run transpile && npm run build:types",
    "prepublishOnly": "npm run build:lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandorip/react-document-viewer.git"
  },
  "keywords": [
    "react",
    "react-component",
    "document",
    "viewer",
    "pdf",
    "image"
  ],
  "author": "Fernando Pires Reherman <nandorip@live.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nandorip/react-document-viewer/issues"
  },
  "homepage": "https://github.com/nandorip/react-document-viewer#readme",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "@mui/material": ">=6 <10",
    "@mui/icons-material": ">=6 <10",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0"
  },
  "dependencies": {
    "react-image-pan-zoom-rotate": "^1.6.0",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "style-loader": "^4.0.0",
    "typescript": "^5.7.3",
    "webpack": "^5.106.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
